{
	"name": "@cldmv/fix-headers",
	"version": "2.5.1",
	"description": "Multi-language project header normalizer with auto-detection and override support.",
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./types/src/index.d.mts",
	"files": [
		"dist/",
		"!dist/**/*.map",
		"types/"
	],
	"exports": {
		".": {
			"fix-headers-dev": {
				"types": "./types/src/index.d.mts",
				"import": "./src/index.mjs",
				"require": "./src/index.cjs"
			},
			"types": "./types/src/index.d.mts",
			"import": "./dist/index.mjs",
			"require": "./dist/index.cjs"
		},
		"./package.json": "./package.json"
	},
	"bin": {
		"fix-headers": "./dist/cli.mjs"
	},
	"scripts": {
		"build:ci": "npm run lint --if-present && npm run format:check --if-present && npm run types:check && npm run types:build && npm run build",
		"test": "node tests/run-vitest.mjs && npm run test:cjs && npm run test:dist",
		"test:cjs": "npm run build && node --conditions=fix-headers-dev --test tests/cjs/entry.test.cjs",
		"test:dist": "npm run build && node tests/run-vitest.mjs --mode=dist",
		"test:watch": "vitest --config .configs/vitest.config.mjs",
		"coverage": "node tests/run-vitest.mjs --coverage-quiet && npm run test:cjs",
		"ci:coverage": "npm run coverage && npm run test:dist",
		"types:build": "tsc -p .configs/tsconfig.json --noCheck && node --conditions=fix-headers-dev ./src/cli.mjs --config .configs/fix-headers.json --input types",
		"types:check": "tsc -p .configs/tsconfig.json --noEmit",
		"cli": "node --conditions=fix-headers-dev ./src/cli.mjs",
		"build": "node scripts/build.mjs",
		"prepack": "node -e \"const fs=require('node:fs');if(fs.existsSync('node_modules/esbuild')){require('node:child_process').execSync('npm run types:build && npm run build',{stdio:'inherit'})}else if(!fs.existsSync('dist/index.mjs')){throw new Error('dist/ is missing and esbuild is unavailable to build it')}\"",
		"lint": "eslint --config .configs/eslint.config.mjs .",
		"lint:fix": "eslint --config .configs/eslint.config.mjs . --fix",
		"format": "prettier --config .configs/.prettierrc --write .",
		"format:check": "prettier --config .configs/.prettierrc --check .",
		"prepare": "node -e \"import('./.githooks/install.mjs').catch(()=>{})\"",
		"fix:headers": "node --conditions=fix-headers-dev ./src/cli.mjs --config .configs/fix-headers.json"
	},
	"keywords": [
		"headers",
		"copyright",
		"automation",
		"node-module"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/CLDMV/fix-headers.git"
	},
	"bugs": {
		"url": "https://github.com/CLDMV/fix-headers/issues"
	},
	"homepage": "https://github.com/CLDMV/fix-headers#readme",
	"engines": {
		"node": ">=18.0.0"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": ">=22.22.0",
			"onFail": "error"
		}
	},
	"author": {
		"name": "Shinrai",
		"company": "CLDMV",
		"email": "git+npm@cldmv.net",
		"url": "https://cldmv.net"
	},
	"contributors": [
		{
			"name": "CLDMV",
			"url": "https://github.com/CLDMV"
		}
	],
	"funding": {
		"type": "github",
		"url": "https://github.com/sponsors/shinrai"
	},
	"publishConfig": {
		"access": "public"
	},
	"license": "Apache-2.0",
	"sideEffects": false,
	"devDependencies": {
		"@cldmv/configs": "^1.4.0",
		"@cldmv/eslint-plugin-jsonv": "^1.0.10",
		"@cldmv/jsonv": "^1.0.9",
		"@cldmv/prettier-plugin-jsonv": "^1.0.6",
		"@cldmv/vitest-runner": "^1.4.2",
		"@eslint/css": "^2.0.0",
		"@eslint/js": "^10.0.1",
		"@eslint/json": "^2.1.0",
		"@eslint/markdown": "^8.0.3",
		"@types/node": "^26.1.1",
		"@vitest/coverage-v8": "^5.0.0",
		"esbuild": "^0.28.2",
		"eslint": "^10.11.0",
		"globals": "^17.14.0",
		"prettier": "^3.9.9",
		"typescript": "^6.0.3",
		"vitest": "^5.0.0"
	},
	"dependencies": {
		"ignore": "^7.0.14"
	},
	"overrides": {
		"esbuild": "$esbuild",
		"katex": ">=0.19.1 <1.0.0",
		"minimatch": "^11.0.3"
	}
}
