{
	"name": "@cldmv/fix-headers",
	"version": "2.0.0",
	"description": "Multi-language project header normalizer with auto-detection and override support.",
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./types/index.d.mts",
	"files": [
		"dist/",
		"!dist/**/*.map",
		"types/",
		"bin/",
		"!bin/**/*.map"
	],
	"exports": {
		".": {
			"fix-headers-dev": {
				"types": "./types/index.d.mts",
				"import": "./src/fix-header.mjs"
			},
			"types": "./types/index.d.mts",
			"import": "./dist/index.mjs",
			"require": "./dist/index.cjs"
		},
		"./package.json": "./package.json"
	},
	"bin": {
		"fix-headers": "./bin/fix-headers.mjs"
	},
	"scripts": {
		"build:ci": "npm run lint --if-present && npm run format:check --if-present && npm run types:check && npm run types:build && npm run build",
		"test": "node tests/run-vitest.mjs",
		"test:watch": "vitest --config .configs/vitest.config.mjs",
		"coverage": "node tests/run-vitest.mjs --coverage-quiet",
		"ci:coverage": "npm run coverage",
		"types:build": "tsc -p .configs/tsconfig.json --noCheck",
		"types:check": "tsc -p .configs/tsconfig.json --noEmit",
		"cli": "node ./src/cli.mjs",
		"build": "node -e \"for (const d of ['dist', 'bin']) require('node:fs').rmSync(d, { recursive: true, force: true })\" && tsup",
		"prepack": "node -e \"const fs=require('node:fs');const hasTsup=fs.existsSync('node_modules/.bin/tsup')||fs.existsSync('node_modules/.bin/tsup.cmd');if(hasTsup){require('node:child_process').execSync('npm run build',{stdio:'inherit'})}else if(!fs.existsSync('dist/index.mjs')){throw new Error('dist/ is missing and tsup is unavailable to build it (expected in a bare package-contents publish dir with a prebuilt dist/; unexpected anywhere else)')}\"",
		"lint": "eslint --config .configs/eslint.config.mjs .",
		"lint:fix": "eslint --config .configs/eslint.config.mjs . --fix",
		"format": "prettier --config .configs/.prettierrc --write .",
		"format:check": "prettier --config .configs/.prettierrc --check .",
		"prepare": "node -e \"import('./.githooks/install.mjs').catch(()=>{})\""
	},
	"keywords": [
		"headers",
		"copyright",
		"automation",
		"node-module"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/CLDMV/fix-headers.git"
	},
	"bugs": {
		"url": "https://github.com/CLDMV/fix-headers/issues"
	},
	"homepage": "https://github.com/CLDMV/fix-headers#readme",
	"engines": {
		"node": ">=22.12.0"
	},
	"author": {
		"name": "Shinrai",
		"company": "CLDMV",
		"email": "git+npm@cldmv.net",
		"url": "https://cldmv.net"
	},
	"contributors": [
		{
			"name": "CLDMV",
			"url": "https://github.com/CLDMV"
		}
	],
	"funding": {
		"type": "github",
		"url": "https://github.com/sponsors/shinrai"
	},
	"publishConfig": {
		"access": "public"
	},
	"license": "Apache-2.0",
	"sideEffects": false,
	"devDependencies": {
		"@cldmv/eslint-plugin-jsonv": "^1.0.10",
		"@cldmv/jsonv": "^1.0.9",
		"@cldmv/prettier-plugin-jsonv": "^1.0.6",
		"@cldmv/vitest-runner": "^1.4.2",
		"@eslint/css": "^2.0.0",
		"@eslint/js": "^10.0.1",
		"@eslint/json": "^2.1.0",
		"@eslint/markdown": "^8.0.3",
		"@types/node": "^26.1.1",
		"@vitest/coverage-v8": "^5.0.0",
		"eslint": "^10.11.0",
		"globals": "^17.12.0",
		"prettier": "^3.9.9",
		"tsup": "^8.5.1",
		"typescript": "^7.0.2",
		"vitest": "^5.0.0"
	},
	"dependencies": {
		"ignore": "^7.0.5"
	}
}
